{
  "name": "router-monitor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prisma:generate": "prisma generate && node scripts/fix-prisma-zod-json-null.cjs",
    "prisma:fix-zod": "node scripts/fix-prisma-zod-json-null.cjs",
    "prebuild": "npm run prisma:generate",
    "dev": "npm run prisma:generate && next dev",
    "dev:turbo": "npm run prisma:generate && next dev --turbo",
    "build": "next build",
    "start": "next start",
    "seed": "prisma db push && prisma db seed",
    "prisma:build": "npm run prisma:generate && prisma db push && next build",
    "lint": "next lint",
    "generate-billing": "ts-node -r tsconfig-paths/register --transpile-only --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\"}\" scripts/generate-billing.ts",
    "auto-isolir": "ts-node -r tsconfig-paths/register --transpile-only --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\"}\" scripts/auto-isolir.ts",
    "sync:ppp-background": "ts-node -r tsconfig-paths/register --transpile-only --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\"}\" scripts/sync-ppp-background.ts",
    "create:admin": "ts-node --transpile-only --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\"}\" scripts/create-dev-admin.ts",
    "test:revenue-basis": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/test-revenue-basis.ts",
    "check:revenue-basis": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/check-revenue-basis.ts",
    "encrypt-router-passwords": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/encrypt-router-passwords.ts",
    "reformat-no-layanan": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/reformat-no-layanan.ts",
    "validate:invoice-settings": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/validate-invoice-settings.ts",
    "db:apply-billing-generate": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/apply-billing-generate-migration.ts",
    "puppeteer:install": "npx puppeteer browsers install chrome",
    "postinstall": "npx puppeteer browsers install chrome"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
