# Database (required)
DATABASE_URL="mysql://user:password@localhost:3306/db_name"

# Wajib untuk cron (generate tagihan, auto isolir). Header: Authorization: Bearer <CRON_SECRET>
# Production: minimal 32 karakter (openssl rand -hex 32). App gagal start jika kosong di NODE_ENV=production.
# Generate tagihan: GET/POST /api/cron/generate-billing (cron harian, jadwal di Pengaturan → Billing)
# Auto isolir: GET/POST /api/cron/auto-isolir
CRON_SECRET="your-secret-key-here-min-32-chars-xxxxxxxxxxxx"

# WhatsApp (woo-wa) — deviceId untuk notifikasi registrasi. Jangan commit nilai production.
# WOOWA_DEVICE_ID=""

# Enkripsi password MikroTik di DB (AES-256-GCM). Wajib di production.
# Generate: openssl rand -hex 32
# Setelah set key, jalankan: npx ts-node --compiler-options "{\"module\":\"CommonJS\"}" scripts/encrypt-router-passwords.ts
# ROUTER_PASSWORD_ENCRYPTION_KEY=""

# Challenge registrasi publik (opsional; fallback ke CRON_SECRET)
# REGISTER_CHALLENGE_SECRET=""

# Cloudflare Turnstile tidak dipakai login Portal Pelanggan.
# TURNSTILE_SECRET_KEY=""
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# PDF invoice (Puppeteer): set 1 hanya jika container tidak mendukung Chromium sandbox
# PUPPETEER_NO_SANDBOX="1"
# Opsional: path Chrome custom. Default: .cache/puppeteer (npm run puppeteer:install)
# PUPPETEER_EXECUTABLE_PATH=""

# Rate limit (middleware) & form login/register: set true hanya di belakang reverse proxy tepercaya
# yang men-set ulang IP asli (mis. X-Real-IP / cf-connecting-ip / X-Forwarded-For).
# TRUST_FORWARD_HEADERS="true"

# Router di LAN (RFC1918): wajib true agar proxy MikroTik bisa connect. Tanpa ini host privat ditolak.
# ROUTEROS_PROXY_ALLOW_PRIVATE_HOSTS="true"

# prisma db seed — set sekali di lingkungan dev/staging (jangan commit nilai ke repo)
# SEED_SUPERADMIN_PASSWORD="ganti-password-kuat"
# SEED_DEMO_ADMIN_PASSWORD="opsional-demo-admin"

# Bootstrap Superadmin lokal (development only): npm run create:admin
# Default: admin / admin123 — override opsional:
# DEV_ADMIN_USERNAME="admin"
# DEV_ADMIN_PASSWORD="admin123"

# Speed Insights (@vercel/speed-insights): otomatis aktif hanya saat deploy di Vercel (env VERCEL=1).
# Self-hosted VPS tanpa proxy Vercel menyebabkan error memuat /_vercel/speed-insights/script.js — itu normal jika komponen dimatikan di luar Vercel.

# Optional
# Fork arsip Komdigi: default sembunyikan navigasi MikroTik
NEXT_PUBLIC_ARSIP_HIDE_MIKROTIK_NAV=true

NODE_ENV="development"
# Session cookie: default secure=true in production (needs HTTPS). If login "succeeds" but you stay on /login over plain HTTP, either set NEXT_PUBLIC_APP_URL to https after SSL, or set SESSION_COOKIE_SECURE=false until then. If APP_URL starts with http://, cookies default to non-Secure automatically.
# SESSION_COOKIE_SECURE="false"
LOG_LEVEL="info"

# Rate limiting: saat ini in-memory (single instance). Untuk production multi-instance
# (Vercel/serverless) set UPSTASH_* dan gunakan Redis. Lihat ISSUES_TO_FIX.md #4.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
